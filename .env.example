# Supabase Configuration (placeholders only — never commit real keys)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Analytics and Monitoring
VITE_GOOGLE_ANALYTICS_ID=your_ga_tracking_id
VITE_PERFORMANCE_ENDPOINT=your_performance_monitoring_endpoint
VITE_ERROR_REPORTING_ENDPOINT=your_error_reporting_endpoint

# Optional: API Configuration
VITE_API_URL=your_backend_api_url
VITE_SMS_API_KEY=your_sms_service_api_key
VITE_MAPS_API_KEY=your_google_maps_api_key
VITE_AR_API_KEY=your_ar_service_api_key

# Stripe — publishable key only in Vite. Never put Stripe secret keys in Vite public env.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Build Configuration
NODE_ENV=production
