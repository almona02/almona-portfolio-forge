{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dealer-verification", "destination": "/dealer-verification.html" },
    { "source": "/dealer-verification-en", "destination": "/dealer-verification-en.html" },
    { "source": "/yilmaz-machines-egypt", "destination": "/yilmaz-machines-egypt.html" },
    { "source": "/yilmaz-machines-egypt-en", "destination": "/yilmaz-machines-egypt-en.html" },
    { "source": "/fabricator-pro-software", "destination": "/fabricator-pro-software.html" },
    { "source": "/fabricator-pro-software-en", "destination": "/fabricator-pro-software-en.html" },
    { "source": "/prestige-agent", "destination": "/index.html" },
    { "source": "/prestige-agent/", "destination": "/index.html" },
    { "source": "/prestige-agent/(.*)", "destination": "/index.html" },
    { "source": "/ydt", "destination": "/index.html" },
    { "source": "/ydt/", "destination": "/index.html" },
    { "source": "/ydt/(.*)", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/products/", "destination": "/index.html" },
    { "source": "/test-scanner", "destination": "/index.html" },
    { "source": "/test-scanner/(.*)", "destination": "/index.html" },
    { "source": "/products/machines/:machineId", "destination": "/index.html" },
    { "source": "/products/machines", "destination": "/index.html" },
    { "source": "/products/machines/", "destination": "/index.html" },
    { "source": "/products/profiles/:profileId", "destination": "/index.html" },
    { "source": "/products/3d-gallery", "destination": "/index.html" },
    { "source": "/products/configurator", "destination": "/index.html" },
    { "source": "/products/ar-viewer", "destination": "/index.html" },
    { "source": "/products/profiles", "destination": "/index.html" },
    { "source": "/products/upvc/windows", "destination": "/index.html" },
    { "source": "/products/upvc/doors", "destination": "/index.html" },
    { "source": "/products/aluminum/thermal-break", "destination": "/index.html" },
    { "source": "/products/(.*)", "destination": "/index.html" },
    { "source": "/fabricator-workflow", "destination": "/index.html" },
    { "source": "/fabricator-workflow/(.*)", "destination": "/index.html" },
    { "source": "/fabricator", "destination": "/index.html" },
    { "source": "/fabricator/projects", "destination": "/index.html" },
    { "source": "/fabricator/(.*)", "destination": "/index.html" },
    { "source": "/egyptian-project-wizard", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}