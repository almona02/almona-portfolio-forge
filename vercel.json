{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dealer-verification", "destination": "/dealer-verification" },
    { "source": "/dealer-verification-en", "destination": "/dealer-verification-en" },
    { "source": "/yilmaz-machines-egypt", "destination": "/yilmaz-machines-egypt" },
    { "source": "/yilmaz-machines-egypt-en", "destination": "/yilmaz-machines-egypt-en" },
    { "source": "/fabricator-pro-software", "destination": "/fabricator-pro-software" },
    { "source": "/fabricator-pro-software-en", "destination": "/fabricator-pro-software-en" },
    { "source": "/prestige-agent", "destination": "/index" },
    { "source": "/prestige-agent/", "destination": "/index" },
    { "source": "/prestige-agent/(.*)", "destination": "/index" },
    { "source": "/ydt", "destination": "/index" },
    { "source": "/ydt/", "destination": "/index" },
    { "source": "/ydt/(.*)", "destination": "/index" },
    { "source": "/machines", "destination": "/index" },
    { "source": "/machines/:path*", "destination": "/index" },
    { "source": "/products/machines/:machineId", "has": [{ "type": "header", "key": "user-agent", "value": "[Gg]ooglebot|[Bb]ingbot|[Ss]lurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex[Bb]ot|[Ss]ogou|[Ee]xabot|[Pp]etal[Bb]ot|[Bb]ytespider|[Ss]emrush[Bb]ot|[Aa]hrefs[Bb]ot|[Mm][Jj]12bot|[Dd]otbot|[Ff]acebookexternalhit|[Ff]acebot|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Pp]interest|[Ss]lackbot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Aa]pplebot|[Gg][Pp][Tt][Bb]ot|[Cc]laude[Bb]ot|[Aa]nthropic-ai|[Pp]erplexity[Bb]ot|[Cc][Cc][Bb]ot|ia_archiver|Quora Link Preview" }], "destination": "/catalogue-models/:machineId" },
    { "source": "/products/machines/:machineId", "destination": "/index" },
    { "source": "/products/machines/(.*)", "destination": "/index" },
    { "source": "/products/machines", "has": [{ "type": "header", "key": "user-agent", "value": "[Gg]ooglebot|[Bb]ingbot|[Ss]lurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex[Bb]ot|[Ss]ogou|[Ee]xabot|[Pp]etal[Bb]ot|[Bb]ytespider|[Ss]emrush[Bb]ot|[Aa]hrefs[Bb]ot|[Mm][Jj]12bot|[Dd]otbot|[Ff]acebookexternalhit|[Ff]acebot|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Pp]interest|[Ss]lackbot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Aa]pplebot|[Gg][Pp][Tt][Bb]ot|[Cc]laude[Bb]ot|[Aa]nthropic-ai|[Pp]erplexity[Bb]ot|[Cc][Cc][Bb]ot|ia_archiver|Quora Link Preview" }], "destination": "/catalogue-machines" },
    { "source": "/products/machines", "destination": "/index" },
    { "source": "/products/profiles/(.*)", "destination": "/index" },
    { "source": "/products/profiles", "destination": "/index" },
    { "source": "/products/3d-gallery", "destination": "/index" },
    { "source": "/products/configurator", "destination": "/index" },
    { "source": "/products/ar-viewer", "destination": "/index" },
    { "source": "/products/upvc/windows", "destination": "/index" },
    { "source": "/products/upvc/doors", "destination": "/index" },
    { "source": "/products/aluminum/thermal-break", "destination": "/index" },
    { "source": "/products/(.*)", "destination": "/index" },
    { "source": "/products", "has": [{ "type": "header", "key": "user-agent", "value": "[Gg]ooglebot|[Bb]ingbot|[Ss]lurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex[Bb]ot|[Ss]ogou|[Ee]xabot|[Pp]etal[Bb]ot|[Bb]ytespider|[Ss]emrush[Bb]ot|[Aa]hrefs[Bb]ot|[Mm][Jj]12bot|[Dd]otbot|[Ff]acebookexternalhit|[Ff]acebot|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Pp]interest|[Ss]lackbot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Aa]pplebot|[Gg][Pp][Tt][Bb]ot|[Cc]laude[Bb]ot|[Aa]nthropic-ai|[Pp]erplexity[Bb]ot|[Cc][Cc][Bb]ot|ia_archiver|Quora Link Preview" }], "destination": "/catalogue-products" },
    { "source": "/products", "destination": "/index" },
    { "source": "/test-scanner", "destination": "/index" },
    { "source": "/test-scanner/(.*)", "destination": "/index" },
    { "source": "/fabricator-workflow", "destination": "/index" },
    { "source": "/fabricator-workflow/(.*)", "destination": "/index" },
    { "source": "/fabricator", "destination": "/index" },
    { "source": "/fabricator/projects", "destination": "/index" },
    { "source": "/fabricator/(.*)", "destination": "/index" },
    { "source": "/egyptian-project-wizard", "destination": "/index" },
    { "source": "/used-machines/00000000-0000-0000-0000-000000000000", "destination": "/api/listing-not-found" },
    { "source": "/used-machines/00000000-0000-0000-0000-000000000000/", "destination": "/api/listing-not-found" },
    { "source": "/used-machines", "destination": "/index" },
    { "source": "/used-machines/:path*", "destination": "/index" },
    { "source": "/((?!api(?:/|$)|\\.well-known(?:/|$)|assets(?:/|$)|models(?:/|$)|images(?:/|$)|documents(?:/|$)|textures(?:/|$)|draco(?:/|$)|.*\\.(?:txt|xml|json|webmanifest|html|avif|js|css|glb|gltf|jpg|jpeg|png|svg|webp|gif|ico|woff2?|pdf|bin|wasm|map)$).*)", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/documents/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
