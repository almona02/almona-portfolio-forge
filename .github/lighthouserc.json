{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4174/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "throttlingMethod": "devtools",
        "maxWaitForLoad": 90000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.30}],
        "categories:accessibility": ["warn", {"minScore": 0.80}],
        "categories:best-practices": ["warn", {"minScore": 0.80}],
        "categories:seo": ["warn", {"minScore": 0.70}],
        "first-contentful-paint": ["warn", {"maxNumericValue": 20000}],
        "largest-contentful-paint": ["warn", {"maxNumericValue": 20000}],
        "total-blocking-time": ["warn", {"maxNumericValue": 1000}],
        "cumulative-layout-shift": ["warn", {"maxNumericValue": 0.5}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "server": {
      "storage": {
        "method": "sql",
        "sqlDialect": "sqlite",
        "sqlDatabasePath": "./.lighthouseci/lhr.sql"
      }
    }
  }
}

