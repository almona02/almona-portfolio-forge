{
  "name": "@almona/industrial-api-client",
  "version": "2.0.0",
  "description": "TypeScript client SDK for Almona Industrial API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "generate": "openapi-generator-cli generate -i ../openapi.json -g typescript-axios -o src/generated --additional-properties=supportsES6=true,withInterfaces=true,typescriptThreePlus=true"
  },
  "keywords": [
    "almona",
    "industrial",
    "api",
    "client",
    "typescript",
    "sdk"
  ],
  "author": "Almona Industrial <api-support@almona.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/almona/industrial-api-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/almona/industrial-api-client-ts/issues"
  },
  "homepage": "https://github.com/almona/industrial-api-client-ts#readme",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "axios": "^1.6.0"
  }
}
