# Business Intelligence
VITE_AMPLITUDE_API_KEY=your_amplitude_production_key
VITE_SEGMENT_WRITE_KEY=your_segment_production_write_key

# ==========================================
# PUSH NOTIFICATIONS & MESSAGING
# ==========================================

# Web Push Notifications
