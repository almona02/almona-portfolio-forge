VITE_EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
VITE_CURRENCY_LAYER_ACCESS_KEY=your_currency_layer_key

# ==========================================
# CDN & STORAGE CONFIGURATION
# ==========================================

# Supabase Storage
VITE_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1
VITE_SUPABASE_STORAGE_BUCKET=almona-files

# CloudFlare CDN
VITE_CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
VITE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Amazon S3 (if used)
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
VITE_AWS_REGION=us-east-1
VITE_AWS_S3_BUCKET=almona-production-assets

# ==========================================
# SECURITY & COMPLIANCE
# ==========================================

# JWT Configuration
VITE_JWT_SECRET=your_super_secure_jwt_secret_key_here
VITE_JWT_EXPIRY=24h
VITE_REFRESH_TOKEN_EXPIRY=7d

# API Rate Limiting
VITE_RATE_LIMIT_REQUESTS=1000
VITE_RATE_LIMIT_WINDOW=3600
VITE_RATE_LIMIT_SKIP_FAILED=true

# CORS Configuration
VITE_CORS_ORIGINS=https://almona.com,https://www.almona.com,https://api.almona.com
VITE_CORS_CREDENTIALS=true

# Security Headers
VITE_CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
VITE_HSTS_MAX_AGE=31536000

# ==========================================
# REGIONAL & LOCALIZATION
# ==========================================

# Default Region Settings
VITE_DEFAULT_REGION=egypt
VITE_DEFAULT_LANGUAGE=ar
VITE_DEFAULT_CURRENCY=EGP
VITE_DEFAULT_TIMEZONE=Africa/Cairo

# Supported Regions
VITE_SUPPORTED_REGIONS=egypt,turkey,uae,saudi,international
VITE_SUPPORTED_LANGUAGES=ar,en,tr,fr

# Egyptian Market Specific
VITE_EGYPT_TAX_RATE=0.14
VITE_EGYPT_VAT_NUMBER=your_egypt_vat_number
VITE_EGYPT_COMMERCIAL_REGISTRY=your_commercial_registry

# Turkish Market Specific  
VITE_TURKEY_KDV_RATE=0.20
VITE_TURKEY_TAX_OFFICE=your_turkey_tax_office
VITE_TURKEY_MERSYS_ID=your_mersys_registration_id

# ==========================================
# THIRD-PARTY INTEGRATIONS
# ==========================================

# Social Media APIs
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id

# Business Intelligence
VITE_SALESFORCE_CLIENT_ID=your_salesforce_client_id
VITE_HUBSPOT_API_KEY=your_hubspot_production_key
VITE_ZOHO_CLIENT_ID=your_zoho_client_id

# Communication Tools
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
VITE_TEAMS_WEBHOOK_URL=your_microsoft_teams_webhook
VITE_DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ==========================================
# DEVELOPMENT & DEBUGGING
# ==========================================

# Development Tools (set to false in production)
VITE_DEBUG_MODE=false
VITE_ENABLE_DEVTOOLS=false
VITE_SHOW_PERFORMANCE_METRICS=false
VITE_LOG_LEVEL=error

# Testing & QA
VITE_ENABLE_TESTING_MODE=false
VITE_TEST_USER_EMAIL=test@almona.com
VITE_CYPRESS_BASE_URL=https://almona.com

# ==========================================
# CUSTOM ALMONA CONFIGURATIONS
# ==========================================

# Company Information
VITE_COMPANY_NAME="Almona Industrial Solutions"
VITE_COMPANY_EMAIL=info@almona.com
VITE_COMPANY_PHONE="+20 xxx xxx xxxx"
VITE_COMPANY_ADDRESS="Cairo, Egypt"

# Support Configuration
VITE_SUPPORT_EMAIL=support@almona.com
VITE_EMERGENCY_PHONE="+20 xxx xxx xxxx"
VITE_TECHNICAL_SUPPORT_HOURS="24/7"

# Feature Flags
VITE_ENABLE_IOT_DASHBOARD=true
VITE_ENABLE_AI_CHATBOT=true
VITE_ENABLE_PREDICTIVE_MAINTENANCE=true
VITE_ENABLE_MOBILE_PWA=true
VITE_ENABLE_OFFLINE_SYNC=true

# ==========================================
# BACKUP & DISASTER RECOVERY
# ==========================================

# Database Backups
VITE_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
VITE_BACKUP_RETENTION_DAYS=30
VITE_BACKUP_STORAGE_URL=s3://almona-backups/

# System Recovery
VITE_FAILOVER_URL=https://backup.almona.com
VITE_RECOVERY_MODE=false
VITE_MAINTENANCE_MODE=false

# ==========================================
# PERFORMANCE OPTIMIZATION
# ==========================================

# Caching Configuration
VITE_CACHE_TTL=3600
VITE_STATIC_CACHE_TTL=86400
VITE_API_CACHE_TTL=300

# Image Optimization
VITE_IMAGE_QUALITY=80
VITE_ENABLE_WEBP=true
VITE_LAZY_LOADING=true

# Bundle Optimization
VITE_CHUNK_SIZE_LIMIT=1000
VITE_TREE_SHAKING=true
VITE_MINIFY=true

# ==========================================
# NOTES FOR DEPLOYMENT
# ==========================================

# 1. Replace all placeholder values with actual production credentials
# 2. Ensure all API keys and secrets are securely stored
# 3. Test each service integration before full deployment
# 4. Configure monitoring alerts for critical services
# 5. Set up automated backups for all data stores
# 6. Verify SSL certificates for all endpoints
# 7. Configure load balancing for high availability
