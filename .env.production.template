# 🚀 ALMONA Portfolio Forge - Production Environment Configuration
# Copy this file to .env.production and fill in your production values

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
VITE_APP_ENV=production
VITE_APP_NAME="Almona Portfolio Forge"
VITE_APP_VERSION=2.0.0
VITE_APP_URL=https://almona.com
VITE_API_BASE_URL=https://api.almona.com

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# Database Configuration
VITE_SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
VITE_SUPABASE_REALTIME_URL=wss://your-project.supabase.co/realtime/v1/websocket

# ==========================================
# AI SERVICES CONFIGURATION
# ==========================================

# Google Gemini AI (Primary AI Engine)
VITE_GEMINI_KEY=your_google_gemini_production_api_key

# Hugging Face (for specialized ML models)
