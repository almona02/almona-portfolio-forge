VITE_PREDICTIVE_MODEL_URL=https://cdn.almona.com/models/predictive-maintenance-v1.json

# ==========================================
# IOT PLATFORM INTEGRATION
# ==========================================

# Primary IoT Platform
VITE_IOT_WEBSOCKET_URL=wss://iot.almona.com/realtime
VITE_IOT_API_URL=https://iot-api.almona.com/v1
VITE_IOT_API_KEY=your_production_iot_api_key
VITE_IOT_DASHBOARD_URL=https://iot-dashboard.almona.com

# Device Management
VITE_IOT_DEVICE_REGISTRY=https://devices.almona.com
VITE_IOT_CERT_PATH=/certificates/iot-production.pem

# Time Series Database
VITE_INFLUXDB_URL=https://influx.almona.com
VITE_INFLUXDB_TOKEN=your_influxdb_production_token
VITE_INFLUXDB_ORG=almona-production
VITE_INFLUXDB_BUCKET=sensor-data

# ==========================================
# MONITORING & ANALYTICS
# ==========================================

# Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production

# User Analytics
VITE_GOOGLE_ANALYTICS_ID=G-YOUR-GA4-MEASUREMENT-ID
VITE_HOTJAR_ID=your_hotjar_production_id
VITE_MIXPANEL_TOKEN=your_mixpanel_production_token

# Performance Monitoring
VITE_DATADOG_CLIENT_TOKEN=your_datadog_rum_client_token
VITE_DATADOG_APPLICATION_ID=your_datadog_application_id
