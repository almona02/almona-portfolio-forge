*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
venv-*/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.html
*.json
# Exception: YDT knowledge base must be tracked for production
!src/lib/ydt/knowledge-base.json
!src/core/authority/version_lock.json
!src/lib/ticketing/sla_policy.json
!docs/ci/typecheck-app-baseline.json
!docs/ci/typecheck-app-baseline.win32.json
!docs/ci/typecheck-app-baseline.linux.json
!docs/ci/README.md
# Exception: i18n locale trees (already tracked historically; keep new namespaces shippable)
!locales/
!locales/**
*.png
# Exception: operator guide live screenshots
!docs/guides/fabricator-operator-guide-screenshots/
!docs/guides/fabricator-operator-guide-screenshots/**
test_report.html
test_report.json
load_test_results.png

