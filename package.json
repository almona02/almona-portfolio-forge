  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npx eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "i18n:audit": "node scripts/i18n-audit.js",
    "ar:optimize": "node scripts/optimize-glb.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "test": "vitest",
    "test:predictive": "vitest run src/lib/predictive/tests",
    "test:all": "vitest run src/lib/predictive/tests src/components/__tests__",
    "test:pricing": "vitest run src/lib/pricing.test.ts",
    "test:watch": "vitest watch",
    "test:api": "cd python_backend && python -m pytest tests/run_tests.py -v",
    "test:react": "vitest run src/hooks/__tests__ --coverage",
    "test:security": "cd python_backend && python -m pytest tests/security_test_fixed.py -v",
    "test:performance": "cd python_backend && python -m pytest tests/load_test.py -v",
    "test:full": "npm run test:api && npm run test:react && npm run test:security && npm run test:performance",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:ci": "vite build --mode production",
    "analyze": "vite build --mode analyze",
    "analyze:bundle": "npm run build && node scripts/analyze-bundle.js",
    "performance": "node scripts/performance-optimize.js",
    "performance:audit": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "performance:budget": "bundlesize",
    "deploy:staging": "ENV=staging docker-compose -f docker-compose.staging.yml up --build -d",
    "deploy:production": "ENV=prod docker-compose -f docker-compose.prod.yml up --build -d",
    "load-test": "locust -f python_backend/tests/load_test.py --host=http://localhost:8000",
    "gen:structure": "node docs/generate-structure.js",
    "docs:generate": "npm run gen:structure",
    "gen:structure:readmes": "node docs/generate-structure-with-readmes.js",
    "type-check": "tsc --noEmit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "scan:dup": "node scripts/find-duplicates.mjs",
    "clean:zero": "node scripts/remove-zero-byte-files.mjs",
    "clean:zero:dry": "node scripts/remove-zero-byte-files.mjs --dry-run=true"
