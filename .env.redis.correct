# ========================================
# CORRECT FORMAT:
# ========================================
# REDIS_HOST should be ONLY the hostname (no port)
# REDIS_PORT should be the port number

REDIS_HOST=caboose.proxy.rlwy.net
REDIS_PORT=26145
REDIS_PASSWORD=your-password-here

# ========================================
# WRONG FORMAT (what you had):
# ========================================
# REDIS_HOST=caboose.proxy.rlwy.net:26145  ❌ Don't include port in host
# REDIS_PORT=6379  ❌ Wrong port
