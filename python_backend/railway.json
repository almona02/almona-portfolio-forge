{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "python_backend/Dockerfile.realistic"
  },
  "deploy": {
    "startCommand": "uvicorn apis.main:app --host 0.0.0.0 --port $PORT --workers 1",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
