{
  "include": [
    "apis"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/venv",
    "**/.venv",
    "ai_services/**",
    "adapters/**",
    "agents/**",
    "scripts/**",
    "tests/**",
    "analyze_*.py"
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "pythonPlatform": "All",
  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.10",
      "extraPaths": [
        "."
      ]
    }
  ]
}

