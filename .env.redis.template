# ========================================
# REDIS CONFIGURATION (Railway)
# ========================================
# Get these from Railway Dashboard → Redis Service → Variables tab

# Option 1: Individual credentials (recommended)
REDIS_HOST=your-redis-host.railway.app
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Option 2: Connection URL (alternative)
# REDIS_URL=redis://default:your-password@your-host.railway.app:6379

# ========================================
# HOW TO GET CREDENTIALS FROM RAILWAY:
# ========================================
# 1. Go to https://railway.app
# 2. Select your project
# 3. Click on your Redis service
# 4. Go to "Variables" tab
# 5. Copy the values for:
#    - REDIS_HOST (e.g., monorail.proxy.rlwy.net)
#    - REDIS_PORT (usually 6379)
#    - REDIS_PASSWORD (long random string)
# 6. Paste them above
# 7. Save this file
# 8. Restart your dev server
# ========================================
